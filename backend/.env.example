# Copy to backend/.env and fill in. Never commit the real .env.
#
#   cp backend/.env.example backend/.env

# ─── Django ──────────────────────────────────────────────────────────────────
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-generate-a-real-key
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Comma-separated origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Database ────────────────────────────────────────────────────────────────
# DB_HOST is overridden to "db" by docker-compose; use localhost outside Docker.
DB_NAME=bcip
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# "require" for managed Postgres (Neon, RDS); "prefer" for the local
# docker-compose db service, which runs without TLS.
DB_SSLMODE=prefer

# ─── Blockchain (Polygon Amoy, chainId 80002) ────────────────────────────────
# Your own Alchemy/Infura endpoint is strongly preferred over the public RPC,
# which rate-limits aggressively.
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
# Filled in by `npm run deploy:amoy` in the blockchain/ directory.
BLOCKCHAIN_CONTRACT_ADDRESS=
# NFR-1.2: server-side only, never sent to the client. Use a throwaway testnet
# key funded from a faucet — never a key that holds real funds.
BLOCKCHAIN_ISSUER_PRIVATE_KEY=
# Seconds to wait for a transaction receipt before treating issuance as failed.
BLOCKCHAIN_TX_TIMEOUT=180
# Block explorer used to build the public verification link (FR-5.5).
BLOCKCHAIN_EXPLORER_URL=https://amoy.polygonscan.com

# ─── Email ───────────────────────────────────────────────────────────────────
# Development default logs mail to the console. For real SMTP, switch to:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# On Render, SMTP ports are blocked — use Resend over HTTPS instead:
#   EMAIL_BACKEND=notifications.email_backends.ResendAPIBackend
#   RESEND_API_KEY=re_...
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@bcip.local

# ─── Frontend ────────────────────────────────────────────────────────────────
# Used to build QR/verification URLs baked into issued PDFs.
FRONTEND_URL=http://localhost:5173

# ─── Admin (NFR-1.12) ────────────────────────────────────────────────────────
# /admin/ is only routed when this is 1. Leave unset/0 for any deployment.
ENABLE_ADMIN=1
