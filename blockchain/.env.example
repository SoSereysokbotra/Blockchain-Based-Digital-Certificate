# Copy to blockchain/.env and fill in. Only needed to DEPLOY.
# `npx hardhat compile` and `npx hardhat test` work with no .env at all —
# tests run on an in-memory chain with no gas cost and no network access.

# RPC endpoint for Polygon Amoy. Defaults to the public endpoint if unset.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of the deploying wallet, without the 0x prefix.
# Use a throwaway testnet account funded from https://faucet.polygon.technology
# Never a key holding real funds. Never commit this file.
DEPLOYER_PRIVATE_KEY=
